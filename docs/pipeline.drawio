<mxfile host="app.diagrams.net" type="device">
  <diagram id="mp2-pipeline" name="pipeline">
    <mxGraphModel dx="1400" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="plant" value="&lt;b&gt;plant/&lt;/b&gt; — the measured actuator model and observation-noise profile (docs/methodology.md). Every simulation below runs on it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5EA;strokeColor=#3A7D44;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1120" height="54" as="geometry"/></mxCell>
        <mxCell id="t1" value="&lt;b&gt;phase1/run_train.sh&lt;/b&gt;&lt;br/&gt;PPO from scratch — 47-dim observation with a gait clock; action = residual on the fixed 2 Hz trot prior.&lt;br/&gt;4 seeds × 500 iterations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF3FB;strokeColor=#3B6EA5;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="400" height="96" as="geometry"/></mxCell>
        <mxCell id="s1" value="shipped: phase1/checkpoints/&lt;br/&gt;cpg_residual_s3_499.pt" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#888888;dashed=1;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="860" y="150" width="300" height="56" as="geometry"/></mxCell>
        <mxCell id="c1" value="&lt;b&gt;phase-1 checkpoint&lt;/b&gt; = the teacher" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#B8860B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="270" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="t2" value="&lt;b&gt;phase2/run_distill.sh&lt;/b&gt;&lt;br/&gt;roll the teacher in sim, fit a 45-dim network (no clock) to its actions in the end-to-end contract" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF3FB;strokeColor=#3B6EA5;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="400" height="84" as="geometry"/></mxCell>
        <mxCell id="s2" value="shipped: phase2/checkpoints/&lt;br/&gt;bc_clone.pt" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#888888;dashed=1;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="860" y="374" width="300" height="56" as="geometry"/></mxCell>
        <mxCell id="c2" value="&lt;b&gt;clone&lt;/b&gt; — same gait, new contract, weak on its own" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#B8860B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="490" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="t3" value="&lt;b&gt;phase2/run_train.sh&lt;/b&gt;&lt;br/&gt;PPO warm-started FROM the clone and pulled back TOWARD it by a constant anchor loss.&lt;br/&gt;4 seeds × 1300 iterations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF3FB;strokeColor=#3B6EA5;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="400" height="96" as="geometry"/></mxCell>
        <mxCell id="s3" value="shipped: phase2/checkpoints/&lt;br/&gt;e2e_anchored_s42_1050.pt" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#888888;dashed=1;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="860" y="600" width="300" height="56" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;phase-2 checkpoint&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#B8860B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="720" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="e1" value="&lt;b&gt;scripts/eval.sh&lt;/b&gt; + analysis/gate_table.py — gates: health, gait family, posture, noise robustness" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF3FB;strokeColor=#3B6EA5;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="760" height="54" as="geometry"/></mxCell>
        <mxCell id="e2" value="&lt;b&gt;phase2/run_select.sh&lt;/b&gt; → scripts/openloop_replay.sh — checkpoint ladder, then the open-loop bar (walks blind ≥ 660 mm)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF3FB;strokeColor=#3B6EA5;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="760" height="54" as="geometry"/></mxCell>
        <mxCell id="e3" value="&lt;b&gt;export_policy&lt;/b&gt; → deploy/ — ONNX + numpy contract, checked against fixtures" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF3FB;strokeColor=#3B6EA5;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="980" width="760" height="54" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br/&gt;blue box: a script you run&lt;br/&gt;yellow pill: the artifact it produces&lt;br/&gt;grey dashed: the copy shipped in the repo&lt;br/&gt;&lt;br/&gt;Solid arrows are the chain; dashed arrows the shortcut. Each shipped file is the default input of the script below it, so the chain can be entered at any step." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="860" y="820" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="edge0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="plant" target="t1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge1" value="retrain, then pick a seed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="t1" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell>
